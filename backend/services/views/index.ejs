<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Microservices Dashboard</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f8f9fa; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .navbar { box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); }
        .table-card { border-radius: 12px; border: none; box-shadow: 0 0 15px rgba(0,0,0,0.05); }
        .table thead th { border-bottom-width: 1px; color: #6c757d; font-weight: 600; text-transform: uppercase; font-size: 0.85rem; }
        .service-name { font-weight: 600; color: #2b3035; }
        .btn-action { border-radius: 8px; font-weight: 500; font-size: 0.9rem; padding: 6px 12px; }
        .search-box { max-width: 300px; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-bold" href="/"><i class="fas fa-server me-2"></i> Microservices Dashboard</a>
            <div class="d-flex align-items-center text-white">
                <span class="me-3" id="lastUpdated"></span>
                <button class="btn btn-outline-light btn-sm" onclick="location.reload()">
                    <i class="fas fa-sync-alt"></i> Refresh
                </button>
            </div>
        </div>
    </nav>

    <div class="container-fluid px-4 pb-5">
        <div class="row mb-3 align-items-center">
            <div class="col-md-6">
                <h4 class="mb-0 text-secondary">Running Services Overview</h4>
            </div>
            <div class="col-md-6 text-md-end mt-3 mt-md-0 d-flex justify-content-md-end">
                <div class="input-group search-box">
                    <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" id="searchInput" class="form-control border-start-0" placeholder="Search services...">
                </div>
            </div>
        </div>

        <div class="card table-card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="servicesTable">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4 py-3">Service Name</th>
                                <th class="py-3">State</th>
                                <th class="py-3">Status</th>
                                <th class="pe-4 py-3 text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if(containers.length === 0) { %>
                                <tr>
                                    <td colspan="4" class="text-center py-5 text-muted">
                                        <i class="fas fa-exclamation-circle fa-2x mb-3 d-block"></i>
                                        No services found. Ensure Docker is running.
                                    </td>
                                </tr>
                            <% } %>
                            <% containers.forEach(container => { %>
                                <tr class="service-row">
                                    <td class="ps-4 py-3 service-name">
                                        <%= container.name %>
                                        <% if(container.hasError) { %>
                                            <span class="badge bg-danger ms-2" title="Recent errors detected in logs"><i class="fas fa-exclamation-triangle"></i></span>
                                        <% } %>
                                    </td>
                                    <td class="py-3">
                                        <% if(container.state.toLowerCase() === 'running') { %>
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1"><i class="fas fa-play-circle me-1"></i>Running</span>
                                        <% } else if(container.state.toLowerCase() === 'exited') { %>
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1"><i class="fas fa-stop-circle me-1"></i>Exited</span>
                                        <% } else { %>
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1"><%= container.state %></span>
                                        <% } %>
                                    </td>
                                    <td class="py-3 text-muted small"><%= container.status %></td>
                                    <td class="pe-4 py-3 text-end">
                                        <a href="/logs/<%= container.name %>" class="btn btn-primary btn-action me-2">
                                            <i class="fas fa-file-alt me-1"></i> Logs
                                        </a>
                                        <a href="/logs/<%= container.name %>?filter=errors" class="btn btn-danger btn-action">
                                            <i class="fas fa-exclamation-triangle me-1"></i> Errors
                                        </a>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Search functionality
        document.getElementById('searchInput').addEventListener('keyup', function() {
            let filter = this.value.toLowerCase();
            let rows = document.querySelectorAll('.service-row');
            
            rows.forEach(row => {
                let name = row.querySelector('.service-name').textContent.toLowerCase();
                if (name.indexOf(filter) > -1) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });

        // Set last updated time
        const now = new Date();
        document.getElementById('lastUpdated').innerText = "Last updated: " + now.toLocaleTimeString();
    </script>
</body>
</html>
